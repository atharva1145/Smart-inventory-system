{
  "info": {
    "_postman_id": "smart-inventory-system-v1",
    "name": "Smart Inventory & Order Management System API",
    "description": "Production-grade REST API collection for Smart Inventory & Order Management System. Includes automated JWT bearer auth token handling, pessimistic concurrency locking, idempotency, and audit trails.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('JWT Token saved to collection variable: token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "Search & Filter Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "query", "value": "", "disabled": true },
                { "key": "categoryId", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-POSTMAN-01\",\n  \"name\": \"Heavy Duty Poly Mailers 10x13\",\n  \"description\": \"Waterproof self-sealing shipping bags (100-pack)\",\n  \"costPrice\": 8.25,\n  \"sellingPrice\": 18.50,\n  \"reorderLevel\": 25,\n  \"unitOfMeasure\": \"PACK\",\n  \"initialStock\": 60,\n  \"binLocation\": \"B-02-S3-B10\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1589939705384-5185137a7f0f?w=400\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Bulk Import Products",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"sku\": \"SKU-BULK-01\",\n    \"name\": \"Industrial Stretch Wrap Roll\",\n    \"costPrice\": 12.00,\n    \"sellingPrice\": 24.99,\n    \"reorderLevel\": 15,\n    \"unitOfMeasure\": \"ROLL\",\n    \"initialStock\": 40,\n    \"binLocation\": \"C-01-S2-B5\"\n  },\n  {\n    \"sku\": \"SKU-BULK-02\",\n    \"name\": \"Bubble Wrap Cushioning 24in x 100ft\",\n    \"costPrice\": 14.50,\n    \"sellingPrice\": 32.00,\n    \"reorderLevel\": 20,\n    \"unitOfMeasure\": \"ROLL\",\n    \"initialStock\": 50,\n    \"binLocation\": \"C-03-S1-B2\"\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/products/bulk",
              "host": ["{{baseUrl}}"],
              "path": ["products", "bulk"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Inventory & Restock",
      "item": [
        {
          "name": "Get Inventory Overview & Balances",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/inventory?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["inventory"]
            }
          }
        },
        {
          "name": "Get Smart Restock Suggestions & Run-Out Forecast",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/inventory/restock-suggestions",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "restock-suggestions"]
            }
          }
        },
        {
          "name": "Get Valuation & Gross Profit Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/inventory/valuation",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "valuation"]
            }
          }
        },
        {
          "name": "Manual Stock Adjustment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"warehouseId\": 1,\n  \"quantityChange\": 5,\n  \"reason\": \"Cycle count physical stock reconciliation discrepancy\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/adjust",
              "host": ["{{baseUrl}}"],
              "path": ["inventory", "adjust"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Customer Orders (Overselling Safe)",
      "item": [
        {
          "name": "Create Order (Idempotent & Concurrency-Safe)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"warehouseId\": 1,\n  \"discountAmount\": 5.00,\n  \"taxRate\": 0.0825,\n  \"idempotencyKey\": \"IDEMP-POSTMAN-{{$timestamp}}\",\n  \"notes\": \"Standard ground shipping\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/orders?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        }
      ]
    },
    {
      "name": "5. System Audit Logs",
      "item": [
        {
          "name": "Search Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/audit-logs?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["audit-logs"]
            }
          }
        }
      ]
    }
  ]
}
